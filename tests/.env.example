# Copy this file to .env and fill in your values.
# Never commit .env — it is excluded by .gitignore.

# ── ClickHouse ────────────────────────────────────────────────────────────────
# HTTP/HTTPS (ClickHouse Cloud default):
# clickhouse_host=your-host.clickhouse.cloud
# clickhouse_port=8443
# clickhouse_transport=http

# Native TCP (Altinity / on-prem with TLS):
clickhouse_host=your-clickhouse-host.example.com
clickhouse_port=9440
clickhouse_transport=native   # "http" or "native" — omit to auto-detect
clickhouse_db=default
clickhouse_user=your_user
clickhouse_password=your_password

# Override for source/destination split testing (optional):
# SOURCE_CLICKHOUSE_HOST=prod-ch.example.com
# SOURCE_CLICKHOUSE_PORT=9440
# SOURCE_CLICKHOUSE_TRANSPORT=native
# SOURCE_CLICKHOUSE_USER=your_user
# SOURCE_CLICKHOUSE_PASSWORD=your_password
# SOURCE_CLICKHOUSE_DB=default

# DEST_CLICKHOUSE_HOST=staging-ch.example.com
# DEST_CLICKHOUSE_PORT=9440
# DEST_CLICKHOUSE_TRANSPORT=native
# DEST_CLICKHOUSE_USER=your_user
# DEST_CLICKHOUSE_PASSWORD=your_password
# DEST_CLICKHOUSE_DB=default

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=your_database
# PG_USER=your_user
# PG_PASSWORD=your_password
# PG_SCHEMAS=public,analytics

# ── MySQL ─────────────────────────────────────────────────────────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=your_database
# MYSQL_USER=your_user
# MYSQL_PASSWORD=your_password

# ── Oracle ───────────────────────────────────────────────────────────────────
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=XEPDB1         # Oracle service name (e.g. ORCL, FREEPDB1)
# ORACLE_USER=your_user
# ORACLE_PASSWORD=your_password
# ORACLE_SCHEMAS=HR,OE           # comma-separated schemas / Oracle users

# Override for source/destination split testing (optional):
# SOURCE_ORACLE_HOST=prod-oracle.example.com
# SOURCE_ORACLE_SERVICE=ORCL
# SOURCE_ORACLE_USER=your_user
# SOURCE_ORACLE_PASSWORD=your_password
# SOURCE_ORACLE_SCHEMAS=HR

# DEST_ORACLE_HOST=staging-oracle.example.com
# DEST_ORACLE_SERVICE=ORCL
# DEST_ORACLE_USER=your_user
# DEST_ORACLE_PASSWORD=your_password

# ── SQL Server ────────────────────────────────────────────────────────────────
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_DB=your_database
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password
# MSSQL_SCHEMAS=dbo              # comma-separated schemas (default: dbo)

# Override for source/destination split testing (optional):
# SOURCE_MSSQL_HOST=prod-sql.example.com
# SOURCE_MSSQL_DB=your_database
# SOURCE_MSSQL_USER=your_user
# SOURCE_MSSQL_PASSWORD=your_password

# DEST_MSSQL_HOST=staging-sql.example.com
# DEST_MSSQL_DB=your_database
# DEST_MSSQL_USER=your_user
# DEST_MSSQL_PASSWORD=your_password

# ── SMTP (email reports) ──────────────────────────────────────────────────────
# Gmail example — use an App Password, not your account password.
# Enable 2-Step Verification first: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Default recipient for test emails
EMAIL_TO=recipient@example.com

# ── Notification type ─────────────────────────────────────────────────────────
# Controls which channel(s) the test suite uses to deliver reports.
# "email" | "slack" | "both"  (default: email)
NOTIFICATION_TYPE=email

# ── Slack notifications ───────────────────────────────────────────────────────
# 1. Create a Slack app at https://api.slack.com/apps
# 2. Add Bot Token Scopes: chat:write, files:write, channels:read, users:read, im:write
# 3. Install to workspace → copy the Bot User OAuth Token (xoxb-…)
# SLACK_BOT_TOKEN=xoxb-your-token-here
# SLACK_NOTIFY_TARGET=#your-channel   # or @username, C… (channel ID), U… (user ID)
